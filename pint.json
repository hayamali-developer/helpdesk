{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "strict_comparison": true,
        "ordered_class_elements": true,
        "Pint/phpdoc_type_annotations_only": true,
        "Pint/laravel_blade": false
    },
    "exclude": [
        "bootstrap/cache",
        "storage"
    ],
    "notName": [
        "*.blade.php"
    ]
}